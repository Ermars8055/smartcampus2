# ------------------------------------------------------------------------------
# SmartCampus Environment Configuration
# Copy this file to .env and fill in the values for your production environment.
# ------------------------------------------------------------------------------

# ----------------
# Database Secrets
# ----------------
# Name of the Postgres database
POSTGRES_DB=nissigrid_stores

# Username for Postgres
POSTGRES_USER=nissigrid

# Secure password for Postgres
POSTGRES_PASSWORD=nissigrid_secure_pwd

# ---------------
# Backend Secrets
# ---------------
# A highly secure, random string used for cryptographic signing. 
# You can generate one using: openssl rand -hex 32
SECRET_KEY=nissigrid-production-secret-change-this

# Allowed origins for CORS (Comma-separated list of domains that can access the API)
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,https://smartcampus.yourdomain.com

# ----------------
# Frontend Config
# ----------------
# The base URL where the frontend expects the backend API to reside.
# If leaving blank, it uses relative paths (recommended for single-server proxy setups).
VITE_API_URL=
